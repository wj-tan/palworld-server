# =====================================================================
# Palworld-on-OCI configuration.  Copy this file to `config.env` and edit.
#   cp config.env.example config.env
# `config.env` is gitignored because it holds passwords.
# =====================================================================

# ---- OCI account / region ----
OCI_REGION="ap-singapore-1"
# Leave COMPARTMENT_OCID blank to use the tenancy (root) compartment.
COMPARTMENT_OCID=""
# Leave AVAILABILITY_DOMAIN blank to auto-detect the first AD in the region.
AVAILABILITY_DOMAIN=""

# ---- Instance shape ----
# ARCH=arm  -> VM.Standard.A1.Flex (Ampere). Up to 2 OCPU / 12 GB is Always Free.
#              Palworld is x86-only, so ARM runs it under box64 emulation.
# ARCH=x86  -> VM.Standard.E5.Flex (AMD). PAID (native, faster, no emulation).
ARCH="arm"
OCPUS="2"
MEMORY_GB="12"
BOOT_VOLUME_GB="50"
INSTANCE_NAME="palworld"

# ---- SSH keys (used to reach the instance) ----
SSH_PUBLIC_KEY="$HOME/.ssh/palworld_oci.pub"
SSH_PRIVATE_KEY="$HOME/.ssh/palworld_oci"

# ---- Network (created if it doesn't exist) ----
VCN_NAME="palworld-vcn"
VCN_CIDR="10.0.0.0/16"
SUBNET_CIDR="10.0.0.0/24"

# ---- Palworld server settings ----
SERVER_NAME="My Palworld Server"
SERVER_DESCRIPTION="Hosted on OCI"
PLAYERS="16"
ADMIN_PASSWORD="CHANGE_ME_admin"
SERVER_PASSWORD=""            # blank = open server; set a value to require a join password
RCON_PASSWORD="CHANGE_ME_rcon"
COMMUNITY_SERVER="false"      # true = listed publicly in the community browser
TZ="Asia/Singapore"

# ---- Off-site backups (OCI Object Storage) ----
BACKUP_BUCKET="palworld-backups"
BACKUP_RETENTION_DAYS="14"
BACKUP_CRON="0 */6 * * *"     # every 6 hours
